-- ========== FOLLOW LOWEST HP + LOCK CAMERA + AUTO SWITCH ON KILL ==========
spawn(function()
    local function getLowestHPTarget()
        local lowestHP = math.huge
        local targetChar = nil
        local targetPlayer = nil
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local h = char.Humanoid
                    if h.Health > 0 and h.Health < lowestHP then
                        lowestHP = h.Health
                        targetChar = char
                        targetPlayer = player
                    end
                end
            end
        end
        return targetChar, targetPlayer, lowestHP
    end

    while true do
        if IsHoping then
            wait(0.5)
            continue
        end

        if not Character or not Character.Parent then
            updateCharacter()
            wait(0.5)
            if not Character then
                wait(0.5)
                continue
            end
        end

        -- === CHECK TARGET STATUS ===
        if CurrentTarget and CurrentTarget.Parent then
            local humanoid = CurrentTarget:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
                CurrentTarget = nil
                CurrentTargetPlayer = nil
                print("Target eliminated! Searching for new target...")
                titleLabel.Text = "Searching target..."
                statusDot.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
            end
        else
            if CurrentTarget then
                CurrentTarget = nil
                CurrentTargetPlayer = nil
                print("Target lost! Searching for new target...")
            end
        end

        -- If no target, find new one
        if not CurrentTarget or not CurrentTarget.Parent then
            local target, player, hp = getLowestHPTarget()
            if target and player then
                CurrentTarget = target
                CurrentTargetPlayer = player
                local humanoid = target:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    CurrentTargetHP = humanoid.Health
                    CurrentTargetMaxHP = humanoid.MaxHealth
                else
                    CurrentTargetHP = 0
                    CurrentTargetMaxHP = 100
                end
                updateIsland(player.Name, CurrentTargetHP, CurrentTargetMaxHP, getAvatarUrl(player), false)
                print("New target: " .. player.Name)
            else
                if titleLabel.Text ~= "No target" then
                    titleLabel.Text = "No target"
                    statusDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                end
                wait(0.5)
                continue
            end
        end

        -- Follow target
        if not HumanoidRootPart then
            updateCharacter()
            if not HumanoidRootPart then
                wait(0.5)
                continue
            end
        end

        local targetRoot = CurrentTarget:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local humanoid = CurrentTarget:FindFirstChildOfClass("Humanoid")
            if humanoid then
                CurrentTargetHP = humanoid.Health
                CurrentTargetMaxHP = humanoid.MaxHealth
                if isExpanded then
                    updateHealthBar(CurrentTarget)
                end
            end

            local behindPos = targetRoot.Position - targetRoot.CFrame.LookVector * 4
            behindPos = Vector3.new(behindPos.X, targetRoot.Position.Y, behindPos.Z)
            HumanoidRootPart.CFrame = CFrame.new(behindPos, targetRoot.Position)
            Camera.CameraSubject = targetRoot
            Camera.CFrame = CFrame.new(behindPos, targetRoot.Position)
        else
            CurrentTarget = nil
            CurrentTargetPlayer = nil
        end

        wait(0.03)
    end
end)

