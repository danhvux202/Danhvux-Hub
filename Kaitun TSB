-- ========== FIRE EVENT ==========
local function fireEvent(data)
    if not Communicate then
        Communicate = Character and Character:FindFirstChild("Communicate")
        if not Communicate then return false end
    end
    local success, err = pcall(function()
        Communicate:FireServer(data)
    end)
    if not success then
        warn("FireServer error: " .. tostring(err))
        return false
    end
    return true
end

