-- Animation
local compressTweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
local expandTweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local fadeTweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local isExpanded = false
local isAnimating = false
local currentData = nil

local function calculatePillWidth(text)
    local textSize = TextService:GetTextSize(text, 13, Enum.Font.GothamMedium, Vector2.new(1000, 38))
    return math.clamp(textSize.X + 55, 160, 380)
end

local function collapseIsland()
    if isAnimating or not isExpanded then return end
    isAnimating = true
    TweenService:Create(expandedFrame, fadeTweenInfo, {GroupTransparency = 1}):Play()
    task.wait(0.1)
    expandedFrame.Visible = false
    compactFrame.Visible = true
    TweenService:Create(compactFrame, fadeTweenInfo, {GroupTransparency = 0}):Play()
    local targetWidth = calculatePillWidth(titleLabel.Text)
    local tweenSize = TweenService:Create(island, expandTweenInfo, {Size = UDim2.new(0, targetWidth, 0, PILL_HEIGHT)})
    local tweenCorner = TweenService:Create(uiCorner, expandTweenInfo, {CornerRadius = UDim.new(0, PILL_HEIGHT / 2)})
    tweenSize:Play()
    tweenCorner:Play()
    tweenSize.Completed:Wait()
    isExpanded = false
    isAnimating = false
end

local function expandIsland()
    if isAnimating or isExpanded or not currentData then return end
    isAnimating = true
    avatarImage.Image = currentData.AvatarUrl or ""
    expTitle.Text = "Target: " .. currentData.Name
    -- Update health bar
    local hp = currentData.HP or 0
    local maxHp = currentData.MaxHP or 100
    local percent = math.clamp(hp / maxHp * 100, 0, 100)
    healthBarFill.Size = UDim2.new(percent / 100, 0, 1, 0)
    hpText.Text = math.floor(percent) .. "%"
    if percent > 60 then
        healthBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
    elseif percent > 30 then
        healthBarFill.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    else
        healthBarFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
    
    TweenService:Create(compactFrame, fadeTweenInfo, {GroupTransparency = 1}):Play()
    task.wait(0.1)
    compactFrame.Visible = false
    expandedFrame.Visible = true
    -- Expand to height 120 to fit all elements
    local tweenSize = TweenService:Create(island, expandTweenInfo, {Size = UDim2.new(0, 350, 0, 120)})
    local tweenCorner = TweenService:Create(uiCorner, expandTweenInfo, {CornerRadius = UDim.new(0, 20)})
    tweenSize:Play()
    tweenCorner:Play()
    TweenService:Create(expandedFrame, fadeTweenInfo, {GroupTransparency = 0}):Play()
    tweenSize.Completed:Wait()
    isExpanded = true
    isAnimating = false
end

