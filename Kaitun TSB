local function updateIsland(targetName, targetHP, targetMaxHP, avatarUrl, isHopMode)
    local title = "Fighting: " .. targetName
    if isHopMode then
        title = "Hop in " .. HopCountdown .. "s | Kill: " .. targetName
    end
    currentData = {
        Name = targetName,
        HP = targetHP or 0,
        MaxHP = targetMaxHP or 100,
        AvatarUrl = avatarUrl
    }
    if isExpanded then
        collapseIsland()
    end
    titleLabel.Text = title
    statusDot.BackgroundColor3 = isHopMode and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 120)
    local targetWidth = calculatePillWidth(title)
    TweenService:Create(island, expandTweenInfo, {Size = UDim2.new(0, targetWidth, 0, PILL_HEIGHT)}):Play()
end

local function updateHealthBar(target)
    if not target then return end
    local humanoid = target:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local hp = humanoid.Health
    local maxHp = humanoid.MaxHealth
    local percent = math.clamp(hp / maxHp * 100, 0, 100)
    healthBarFill.Size = UDim2.new(percent / 100, 0, 1, 0)
    hpText.Text = math.floor(percent) .. "%"
    if percent > 60 then
        healthBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
    elseif percent > 30 then
        healthBarFill.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    else
        healthBarFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end

