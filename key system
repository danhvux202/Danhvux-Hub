// File: api/key.js
import { kv } from '@vercel/kv';

export default async function handler(req, res) {
    const { method } = req;

    // 1. Logic lấy Key ngẫu nhiên (GET)
    if (method === 'GET') {
        const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let randomKey = 'DVX-'; // Tiền tố Danhvux
        for (let i = 0; i < 10; i++) {
            randomKey += characters.charAt(Math.floor(Math.random() * characters.length));
        }

        // Lưu key vào Vercel KV, hết hạn sau 24 giờ (86400 giây)
        await kv.set(randomKey, 'active', { ex: 86400 });

        return res.status(200).json({ 
            success: true, 
            key: randomKey,
            message: "Key có hiệu lực trong 24h" 
        });
    }

    // 2. Logic kiểm tra Key (POST)
    if (method === 'POST') {
        const { key } = req.body;
        const status = await kv.get(key);

        if (status === 'active') {
            return res.status(200).json({ authorized: true });
        } else {
            return res.status(401).json({ authorized: false, message: "Key không hợp lệ hoặc đã hết hạn" });
        }
    }

    return res.status(405).json({ message: "Method not allowed" });
}
