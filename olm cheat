        teacherDocAnswers.forEach((qa, i) => {
            const clean = (s) => String(s == null ? '' : s).replace(/\[IMG:[^\]]+\]/g, '[công thức]');
            lines.push(`[${String(i + 1).padStart(2, '0')}] ${clean(qa.question)}`);
