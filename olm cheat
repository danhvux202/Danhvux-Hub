    function createSelectionHighlight(rect) {
        if (selectionBadge) selectionBadge.remove();
        selectionBadge = document.createElement('div');
        selectionBadge.id = 'olm-selection-highlight';
        selectionBadge.style.cssText = `position: fixed; left: ${rect.left - 3}px; top: ${rect.top - 3}px; width: ${rect.width + 6}px; height: ${rect.height + 6}px; border: 1.5px solid rgba(10,132,255,0.8); border-radius: 8px; background: rgba(10,132,255,0.06); pointer-events: none; z-index: 2147483645; transition: opacity 0.3s ease;`;
        document.body.appendChild(selectionBadge);
    }
    function hideSelectionHighlight() {
        if (selectionBadge) {
            selectionBadge.style.opacity = '0';
            setTimeout(() => { if (selectionBadge) { selectionBadge.remove(); selectionBadge = null; } }, 300);
        }
    }

    function handleTextSelection() {
        const selection = window.getSelection();
        const selectedText = cleanText(selection.toString());
        if (selectedText.length < 3) { hideSelectionHighlight(); return; }
        const anchor = selection.anchorNode;
        if (anchor && anchor.parentElement) {
            let el = anchor.parentElement;
            while (el) { if (el.id === 'olm-cheat-panel' || el.id === 'olm-dynamic-island' || el.id === 'olm-music-modal') return; el = el.parentElement; }
        }
        try {
            const range = selection.getRangeAt(0);
            const rect = range.getBoundingClientRect();
            if (rect.width > 0) createSelectionHighlight(rect);
        } catch (e) { }

        if (islandMode === 'music' && Music.current && Music.isPlaying) {
            // Don't override music island; just search
            searchSelectedText(selectedText);
            return;
        }

        showDynamicIsland();
        updateIslandLoading();
        const searchId = ++islandSearchId;
        setTimeout(() => {
            const cur = cleanText(window.getSelection().toString());
            if (searchId !== islandSearchId) return;
            if (cur === selectedText && selectedText.length >= 3) searchSelectedText(selectedText);
        }, 400);
    }

    async function searchSelectedText(text) {
        const clean = cleanText(text);
        if (clean.length < 2) return;

        const teacherAnswer = findAnswerByQuestionText(clean);
        if (teacherAnswer) {
            const ans = teacherAnswer.answerText || teacherAnswer.answerLetter;
            displayAIAnswer(ans, 99, 'DOC');
            if (teacherAnswer.answerLetter) highlightAnswer(teacherAnswer.answerLetter);
            if (!(islandMode === 'music' && Music.current && Music.isPlaying)) {
                updateIslandResult({ text: ans, source: 'DOC' });
            }
            updateStats('docHits');
            return;
        }

        const cached = getCachedAnswer(clean);
        if (cached) {
            displayAIAnswer(cached.answer, 95, 'CACHE');
            if (cached.answer.match(/^[A-D]/)) highlightAnswer(cached.answer[0]);
            if (!(islandMode === 'music' && Music.current && Music.isPlaying)) {
                updateIslandResult({ text: cached.answer, source: 'CACHE' });
            }
            updateStats('cacheHits');
            return;
        }

        await askAIForAnswer(clean, !(islandMode === 'music' && Music.current && Music.isPlaying));
    }

    let selectionDebounce = null;
    function setupSelectionSearch() {
        if (!CONFIG.selectionSearch) return;
        document.addEventListener('mouseup', (e) => {
            let el = e.target;
            while (el) { if (el.id === 'olm-cheat-panel' || el.id === 'olm-dynamic-island' || el.id === 'olm-music-modal') return; el = el.parentElement; }
            if (selectionDebounce) clearTimeout(selectionDebounce);
            selectionDebounce = setTimeout(handleTextSelection, 30);
        });
        document.addEventListener('mousedown', (e) => {
            let el = e.target;
            while (el) { if (el.id === 'olm-cheat-panel' || el.id === 'olm-dynamic-island' || el.id === 'olm-music-modal') return; el = el.parentElement; }
            hideSelectionHighlight();
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { hideSelectionHighlight(); if (!(islandMode === 'music' && Music.current)) hideDynamicIsland(); } });
    }

