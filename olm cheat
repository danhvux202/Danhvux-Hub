        if (mode === 'loading') pill.classList.add('is-loading');
        else if (mode === 'result') pill.classList.add('has-content');
        else if (mode === 'music') pill.classList.add('is-music', 'has-content');
    }

    function updateIslandLoading() {
        if (!dynamicIsland) return;
        islandMode = 'searching';
        setPillMode('loading');
        const iconEl = document.getElementById('island-icon');
        const answerEl = document.getElementById('island-answer');
        const metaEl = document.getElementById('island-meta');
        const eq = document.getElementById('island-eq');
        if (iconEl) { iconEl.className = 'island-icon'; iconEl.innerHTML = '<div class="spinner"></div>'; }
        if (answerEl) answerEl.textContent = '';
        if (metaEl) metaEl.textContent = '';
        if (eq) eq.style.display = 'none';
        showDynamicIsland();
    }

    function updateIslandResult(data) {
        if (!dynamicIsland) return;
        if (islandMode === 'music' && Music.current && Music.isPlaying) return;
        islandMode = 'answered';
        setPillMode('result');
        const iconEl = document.getElementById('island-icon');
        const answerEl = document.getElementById('island-answer');
        const metaEl = document.getElementById('island-meta');
        const eq = document.getElementById('island-eq');
        if (iconEl) {
            iconEl.className = 'island-icon success';
            iconEl.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>`;
        }
        if (answerEl) { answerEl.className = 'island-answer'; answerEl.textContent = data.text || '?'; }
        if (metaEl) metaEl.textContent = data.source === 'DOC' ? 'TỪ ĐỀ' : data.source === 'CACHE' ? 'CACHE' : 'AI';
        if (eq) eq.style.display = 'none';
        // Restore inner HTML if it was music expanded
        const pill = document.getElementById('island-pill');
        if (pill && !pill.querySelector('.island-text')) {
            pill.innerHTML = `
                <div class="island-icon" id="island-icon"></div>
                <div class="island-text" id="island-text">
                    <div class="island-answer" id="island-answer"></div>
                    <div class="island-meta" id="island-meta"></div>
                </div>
                <div class="island-dots" id="island-dots"><span></span><span></span><span></span></div>
                <div class="island-eq" id="island-eq" style="display:none;"><span></span><span></span><span></span><span></span></div>
            `;
            updateIslandResult(data);
            return;
        }
        showDynamicIsland();
        clearTimeout(islandHideTimer);
        islandHideTimer = setTimeout(() => hideDynamicIsland(), 5000);
    }

    function updateIslandError(msg) {
        if (!dynamicIsland) return;
        if (islandMode === 'music') return;
        islandMode = 'answered';
        setPillMode('result');
        const iconEl = document.getElementById('island-icon');
        const answerEl = document.getElementById('island-answer');
        const metaEl = document.getElementById('island-meta');
        const eq = document.getElementById('island-eq');
        if (iconEl) { iconEl.className = 'island-icon error'; iconEl.textContent = '!'; iconEl.innerHTML = '!'; }
        if (answerEl) { answerEl.className = 'island-answer error'; answerEl.textContent = msg || 'Có lỗi'; }
        if (metaEl) metaEl.textContent = 'LỖI';
        if (eq) eq.style.display = 'none';
        const pill = document.getElementById('island-pill');
        if (pill && !pill.querySelector('.island-text')) {
            pill.innerHTML = `
                <div class="island-icon" id="island-icon"></div>
                <div class="island-text" id="island-text">
                    <div class="island-answer" id="island-answer"></div>
                    <div class="island-meta" id="island-meta"></div>
                </div>
                <div class="island-dots" id="island-dots"><span></span><span></span><span></span></div>
                <div class="island-eq" id="island-eq" style="display:none;"><span></span><span></span><span></span><span></span></div>
            `;
            updateIslandError(msg);
            return;
        }
        showDynamicIsland();
        clearTimeout(islandHideTimer);
        islandHideTimer = setTimeout(() => hideDynamicIsland(), 4500);
    }

    // Render music island - only rebuild when structure changes
    function renderIslandMusic(force = false) {
        if (!dynamicIsland) createDynamicIsland();
        const pill = document.getElementById('island-pill');
        if (!pill || !Music.current) return;

        const newState = `${Music.expanded ? 'E' : 'M'}|${Music.isPlaying ? 'P' : 'S'}`;
        const stateChanged = force || newState !== Music.lastRenderedState;

        islandMode = 'music';
        pill.classList.remove('is-loading', 'has-content');
        pill.classList.add('is-music', 'has-content');
        pill.classList.toggle('expanded', Music.expanded);
        showDynamicIsland();
        clearTimeout(islandHideTimer);

        if (!stateChanged) {
            // Just update progress bar & title if expanded
            if (Music.expanded) {
                const fill = document.getElementById('music-bar-fill');
                const cur = document.getElementById('music-time-cur');
                const pct = Music.duration > 0 ? (Music.currentTime / Music.duration) * 100 : 0;
                if (fill) fill.style.width = pct + '%';
                if (cur) cur.textContent = formatTime(Music.currentTime);
            }
            return;
        }
        Music.lastRenderedState = newState;

        const m = Music.current;
        const thumb = m.thumbnail || '';
        const paused = !Music.isPlaying;

        if (Music.expanded) {
            const pct = Music.duration > 0 ? (Music.currentTime / Music.duration) * 100 : 0;
            pill.innerHTML = `
                <div class="island-music-expanded">
                    <div class="music-cover ${paused ? 'paused' : ''}">
                        ${thumb ? `<img src="${thumb}" alt="" onerror="this.style.display='none'">` : `<div class="disc"></div>`}
                        <div class="banner">NOW PLAYING</div>
                    </div>
                    <div class="music-info">
                        <div class="music-title">${escapeHtml(m.title)}</div>
                        <div class="music-artist">${escapeHtml(m.artist || 'Unknown Artist')}</div>
                        <div class="music-progress-wrap">
                            <span class="music-time" id="music-time-cur">${formatTime(Music.currentTime)}</span>
                            <div class="music-bar-bg" id="music-bar-bg"><div class="music-bar-fill" id="music-bar-fill" style="width:${pct}%"></div></div>
                            <span class="music-time" id="music-time-dur">${formatTime(Music.duration)}</span>
                        </div>
                        <div class="music-controls">
                            <button class="music-btn" id="music-btn-prev" title="Restart">${ICONS.prev}</button>
                            <button class="music-btn play" id="music-btn-toggle" title="Play/Pause">${paused ? ICONS.play : ICONS.pause}</button>
                            <button class="music-btn" id="music-btn-next" title="+10s">${ICONS.next}</button>
                            <button class="music-btn" id="music-btn-close" title="Stop">${ICONS.close}</button>
                        </div>
                    </div>
                </div>`;
            const toggleBtn = document.getElementById('music-btn-toggle');
            if (toggleBtn) toggleBtn.onclick = (e) => { e.stopPropagation(); toggleMusicPlayPause(); };
            const closeBtn = document.getElementById('music-btn-close');
            if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); stopMusic(); Music.expanded = false; islandMode = 'idle'; hideDynamicIsland(); };
            const prevBtn = document.getElementById('music-btn-prev');
            if (prevBtn) prevBtn.onclick = (e) => { e.stopPropagation(); seekMusic(0); };
            const nextBtn = document.getElementById('music-btn-next');
            if (nextBtn) nextBtn.onclick = (e) => { e.stopPropagation(); seekMusic(Math.min(Music.duration - 1, Music.currentTime + 10)); };
            const barBg = document.getElementById('music-bar-bg');
            if (barBg) barBg.onclick = (e) => {
                e.stopPropagation();
                const rect = barBg.getBoundingClientRect();
                const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                seekMusic(pct * Music.duration);
            };
        } else {
            pill.innerHTML = `
                <div class="music-mini">
                    <div class="music-mini-cover ${paused ? 'paused' : ''}">
                        ${thumb ? `<img src="${thumb}" alt="" onerror="this.style.display='none'">` : `<div class="disc-mini"></div>`}
                    </div>
                    <div class="music-mini-text">
                        <div class="music-mini-title">${escapeHtml(m.title)}</div>
                        <div class="music-mini-artist">${escapeHtml(m.artist || '')}</div>
                    </div>
                    <div class="island-eq ${paused ? 'paused' : ''}"><span></span><span></span><span></span><span></span></div>
                </div>`;
        }
    }

    function updateIslandMusicProgress() {
        if (islandMode !== 'music' || !Music.expanded) return;
        // Throttle to 1Hz
        const now = Date.now();
        if (now - Music.lastProgressAt < 900) return;
        Music.lastProgressAt = now;
        const pct = Music.duration > 0 ? (Music.currentTime / Music.duration) * 100 : 0;
        const fill = document.getElementById('music-bar-fill');
        const cur = document.getElementById('music-time-cur');
        const dur = document.getElementById('music-time-dur');
        if (fill) fill.style.width = pct + '%';
        if (cur) cur.textContent = formatTime(Music.currentTime);
        if (dur) dur.textContent = formatTime(Music.duration);
    }

    function seekMusic(sec) {
        if (Music.ytPlayer && Music.ytPlayer.seekTo) Music.ytPlayer.seekTo(sec, true);
        else if (Music.audioEl) Music.audioEl.currentTime = sec;
        Music.currentTime = sec;
        Music.lastProgressAt = 0;
        updateIslandMusicProgress();
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    // ============================================
    // MUSIC PLAYER
    // ============================================

    function loadYouTubeAPI() {
        return new Promise((resolve) => {
            if (Music.apiLoaded && window.YT && window.YT.Player) return resolve();
            if (window.YT && window.YT.Player) { Music.apiLoaded = true; return resolve(); }
            if (!window.onYouTubeIframeAPIReady) {
                window.onYouTubeIframeAPIReady = () => {
                    Music.apiLoaded = true;
                    resolve();
                };
            }
            if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
                const tag = document.createElement('script');
                tag.src = 'https://www.youtube.com/iframe_api';
                document.head.appendChild(tag);
            } else {
                const check = setInterval(() => {
                    if (window.YT && window.YT.Player) { clearInterval(check); Music.apiLoaded = true; resolve(); }
                }, 200);
            }
        });
    }

    function parseMusicURL(url) {
        if (!url) return null;
        url = url.trim();
        let m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
        if (m) return { source: 'youtube', id: m[1], url };
        if (/soundcloud\.com\/[\w-]+\/[\w-]+/.test(url)) return { source: 'soundcloud', id: url, url };
        m = url.match(/nhaccuatui\.com\/.*?\/([\w-]+)/);
        if (m) return { source: 'nhaccuatui', id: m[1], url };
        m = url.match(/zingmp3\.vn\/.*?\/([\w-]+)/);
        if (m) return { source: 'zingmp3', id: m[1], url };
        if (/\.(mp3|m4a|wav|ogg|flac|aac)(\?|$)/i.test(url)) return { source: 'direct', id: url, url };
        if (/music\.apple\.com/.test(url)) return { source: 'apple', id: url, url };
        if (/open\.spotify\.com/.test(url)) return { source: 'spotify', id: url, url };
        return null;
    }

    async function fetchYouTubeInfo(videoId) {
        try {
            const res = await gmFetch(`https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${videoId}&format=json`);
            if (res.ok) {
                const data = await res.json();
                return {
                    title: data.title || 'Unknown',
                    artist: data.author_name || 'YouTube',
                    thumbnail: data.thumbnail_url || `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
                    duration: 0
                };
            }
        } catch (e) { }
        return { title: 'YouTube Audio', artist: 'YouTube', thumbnail: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`, duration: 0 };
    }

    async function fetchSoundCloudInfo(url) {
        try {
            const res = await gmFetch(`https://soundcloud.com/oembed?format=json&url=${encodeURIComponent(url)}`);
            if (res.ok) {
                const data = await res.json();
                return {
                    title: data.title || 'SoundCloud Audio',
                    artist: data.author_name || 'SoundCloud',
                    thumbnail: data.thumbnail_url || '',
                    duration: 0
                };
            }
        } catch (e) { }
        return { title: 'SoundCloud Audio', artist: 'SoundCloud', thumbnail: '', duration: 0 };
    }

    function titleFromSlug(url) {
        try {
            const parts = url.split('/').filter(Boolean);
            const last = parts[parts.length - 1].replace(/\.(html?|php|mp3|m4a|wav|ogg)$/i, '').replace(/-/g, ' ');
            return last.replace(/\b\w/g, c => c.toUpperCase());
        } catch (e) { return 'Unknown Track'; }
    }

    async function playMusicURL(url) {
        const info = parseMusicURL(url);
        if (!info) {
            updateIslandError('Link không hợp lệ');
            alert('Không nhận diện được link nhạc.\n\nHỗ trợ: YouTube, SoundCloud, Nhaccuatui, Zing MP3, file .mp3 trực tiếp, Apple Music, Spotify.');
            return;
        }

        stopMusic();
        showDynamicIsland();
        updateIslandLoading();

        try {
            let meta = { title: 'Loading...', artist: '', thumbnail: '', duration: 0 };

            if (info.source === 'youtube') {
                meta = await fetchYouTubeInfo(info.id);
                await loadYouTubeAPI();
                await new Promise((resolve) => {
                    let ytHost = document.getElementById('olm-yt-host');
                    if (!ytHost) {
                        ytHost = document.createElement('div');
                        ytHost.id = 'olm-yt-host';
                        ytHost.style.cssText = 'position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;';
                        document.body.appendChild(ytHost);
                    }
                    ytHost.innerHTML = '<div id="olm-yt-player"></div>';
                    Music.ytPlayer = new window.YT.Player('olm-yt-player', {
                        height: '1', width: '1', videoId: info.id,
                        playerVars: { autoplay: 1, controls: 0, disablekb: 1, fs: 0, modestbranding: 1, playsinline: 1, rel: 0 },
                        events: {
                            onReady: (e) => {
                                try { e.target.setVolume(Music.volume * 100); e.target.playVideo(); } catch (err) { }
                                resolve();
                            },
                            onStateChange: (e) => {
                                if (e.data === window.YT.PlayerState.PLAYING) {
                                    Music.isPlaying = true;
                                    Music.duration = Music.ytPlayer.getDuration() || 0;
                                    meta.duration = Music.duration;
                                    if (islandMode === 'music') renderIslandMusic(true);
                                } else if (e.data === window.YT.PlayerState.PAUSED) {
                                    Music.isPlaying = false;
                                    if (islandMode === 'music') renderIslandMusic(true);
                                } else if (e.data === window.YT.PlayerState.ENDED) {
                                    Music.isPlaying = false;
                                    if (islandMode === 'music') renderIslandMusic(true);
                                }
                            }
                        }
                    });
                    setTimeout(resolve, 4000);
                });
            } else if (info.source === 'soundcloud') {
                meta = await fetchSoundCloudInfo(url);
                let host = document.getElementById('olm-sc-host');
                if (!host) {
                    host = document.createElement('div');
                    host.id = 'olm-sc-host';
                    host.style.cssText = 'position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;';
                    document.body.appendChild(host);
                }
                host.innerHTML = `<iframe id="olm-sc-iframe" width="1" height="1" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=false"></iframe>`;
                Music.isPlaying = true;
            } else if (info.source === 'direct') {
                if (!Music.audioEl) Music.audioEl = new Audio();
                Music.audioEl.src = url;
                Music.audioEl.volume = Music.volume;
                Music.audioEl.addEventListener('timeupdate', () => {
                    Music.currentTime = Music.audioEl.currentTime;
                    Music.duration = Music.audioEl.duration || 0;
                    if (islandMode === 'music') updateIslandMusicProgress();
                });
                Music.audioEl.addEventListener('ended', () => { Music.isPlaying = false; if (islandMode === 'music') renderIslandMusic(true); });
                await Music.audioEl.play();
                Music.isPlaying = true;
                meta = { title: titleFromSlug(url) || 'Audio File', artist: 'Direct Audio', thumbnail: '', duration: Music.audioEl.duration || 0 };
            } else if (info.source === 'nhaccuatui' || info.source === 'zingmp3') {
                meta = { title: titleFromSlug(url), artist: info.source === 'zingmp3' ? 'Zing MP3' : 'Nhaccuatui', thumbnail: '', duration: 0 };
                window.open(url, '_blank');
                Music.isPlaying = false;
                alert('Nền tảng này không hỗ trợ phát trực tiếp trong script.\nĐã mở tab mới để bạn nghe.');
            } else if (info.source === 'apple' || info.source === 'spotify') {
                window.open(url, '_blank');
                meta = { title: titleFromSlug(url), artist: info.source === 'apple' ? 'Apple Music' : 'Spotify', thumbnail: '', duration: 0 };
                Music.isPlaying = false;
                alert('Đã mở tab mới để bạn nghe trên nền tảng này.');
            }

            Music.current = { ...info, ...meta };
            Music.isPlaying = info.source === 'nhaccuatui' || info.source === 'zingmp3' || info.source === 'apple' || info.source === 'spotify' ? false : true;

            startMusicProgressTimer();
            islandMode = 'music';
            Music.lastRenderedState = '';
            renderIslandMusic(true);
        } catch (err) {
            log('Play music error: ' + err.message, '#ff453a');
            updateIslandError('Không phát được nhạc');
            Music.isPlaying = false;
        }
    }

    function toggleMusicPlayPause() {
        if (!Music.current) return;
        if (Music.current.source === 'youtube' && Music.ytPlayer && Music.ytPlayer.pauseVideo) {
            if (Music.isPlaying) { Music.ytPlayer.pauseVideo(); Music.isPlaying = false; }
            else { Music.ytPlayer.playVideo(); Music.isPlaying = true; }
        } else if (Music.audioEl) {
            if (Music.isPlaying) { Music.audioEl.pause(); Music.isPlaying = false; }
            else { Music.audioEl.play(); Music.isPlaying = true; }
        } else if (Music.current.source === 'soundcloud') {
            const iframe = document.getElementById('olm-sc-iframe');
            if (iframe) {
                iframe.contentWindow.postMessage(JSON.stringify({ method: Music.isPlaying ? 'pause' : 'play' }), '*');
                Music.isPlaying = !Music.isPlaying;
            }
        }
        if (islandMode === 'music') renderIslandMusic(true);
    }

    function stopMusic() {
        try { if (Music.ytPlayer) { Music.ytPlayer.stopVideo(); Music.ytPlayer.destroy(); Music.ytPlayer = null; } } catch (e) { }
        try { if (Music.audioEl) { Music.audioEl.pause(); Music.audioEl.src = ''; } } catch (e) { }
        const sc = document.getElementById('olm-sc-host');
        if (sc) sc.innerHTML = '';
        Music.isPlaying = false;
        Music.currentTime = 0;
        Music.duration = 0;
        if (Music.progressTimer) { clearInterval(Music.progressTimer); Music.progressTimer = null; }
        Music.lastRenderedState = '';
    }

    function startMusicProgressTimer() {
        if (Music.progressTimer) clearInterval(Music.progressTimer);
        Music.progressTimer = setInterval(() => {
            if (!Music.current) return;
            if (Music.current.source === 'youtube' && Music.ytPlayer && Music.ytPlayer.getCurrentTime) {
                try {
                    Music.currentTime = Music.ytPlayer.getCurrentTime() || 0;
                    Music.duration = Music.ytPlayer.getDuration() || Music.duration;
                } catch (e) { }
            }
            if (islandMode === 'music' && Music.expanded) updateIslandMusicProgress();
        }, 1000);
    }

    function formatTime(sec) {
        if (!sec || isNaN(sec)) return '0:00';
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return `${m}:${String(s).padStart(2, '0')}`;
    }

