    function cleanText(text) {
        if (!text) return '';
        return text
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .replace(/[\u00A0\u2000-\u200A\u202F\u205F\u3000]/g, ' ')
            .replace(/[\r\n\t]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function removeDiacritics(str) {
        if (!str) return '';
        return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');
    }

    function normalizeVietnamese(text) {
        if (!text) return '';
        text = text.replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F700}-\u{1F77F}\u{1F780}-\u{1F7FF}\u{1F800}-\u{1F8FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '');
        text = cleanText(text);
        return removeDiacritics(text.toLowerCase());
    }

    function normalizeAggressive(text) {
        if (!text) return '';
        let t = text.replace(/[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F700}-\u{1F77F}\u{1F780}-\u{1F7FF}\u{1F800}-\u{1F8FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '');
        t = cleanText(t);
        t = removeDiacritics(t.toLowerCase());
        t = t.replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
        return t;
    }

    function levenshteinDistance(str1, str2) {
        const m = str1.length, n = str2.length;
        if (m === 0) return n;
        if (n === 0) return m;
        // Guard against huge strings
        if (m > 500 || n > 500) {
            // Fallback: token overlap count
            return Math.abs(m - n);
        }
        const dp = Array(m + 1).fill(null).map(() => Array(n + 1).fill(0));
        for (let i = 0; i <= m; i++) dp[i][0] = i;
        for (let j = 0; j <= n; j++) dp[0][j] = j;
        for (let i = 1; i <= m; i++) for (let j = 1; j <= n; j++)
            dp[i][j] = str1[i - 1] === str2[j - 1]
                ? dp[i - 1][j - 1]
                : Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + 1);
        return dp[m][n];
    }

    function calculateSimilarity(str1, str2) {
        const longer = str1.length > str2.length ? str1 : str2;
        const shorter = str1.length > str2.length ? str2 : str1;
        if (longer.length === 0) return 1.0;
        return (longer.length - levenshteinDistance(longer, shorter)) / longer.length;
    }

    function tokenSimilarity(str1, str2) {
        const tokens1 = str1.split(/\s+/).filter(t => t.length > 1);
        const tokens2 = str2.split(/\s+/).filter(t => t.length > 1);
        if (tokens1.length === 0 || tokens2.length === 0) return 0;
        const set2 = new Set(tokens2);
        let matchCount = 0;
        for (const t of tokens1) {
            if (set2.has(t)) { matchCount++; continue; }
            for (const t2 of set2) {
                if (t2.length >= 3 && (t.includes(t2) || t2.includes(t))) { matchCount += 0.5; break; }
            }
        }
        return matchCount / Math.max(tokens1.length, tokens2.length);
    }

    function findBestMatch(query, candidates) {
        if (!candidates || candidates.length === 0) return null;
        const cleanQuery = cleanText(query);
        if (cleanQuery.length < 2) return null;

        const nq = normalizeVietnamese(cleanQuery);
        const aq = normalizeAggressive(cleanQuery);

        let bestMatch = null, bestScore = 0;

        for (const candidate of candidates) {
            const candText = cleanText(candidate.question);
            const nc = normalizeVietnamese(candText);
            const ac = normalizeAggressive(candText);

            // 1. Substring
            if (nq.length >= 4 && nc.includes(nq)) {
                const score = 0.95 + (0.05 * (nq.length / nc.length));
                if (score > bestScore) { bestScore = score; bestMatch = candidate; }
                continue;
            }
            // 2. Aggressive substring
            if (aq.length >= 4 && ac.includes(aq)) {
                const score = 0.9 + (0.05 * (aq.length / ac.length));
                if (score > bestScore) { bestScore = score; bestMatch = candidate; }
                continue;
            }
            // 3. Levenshtein (only if lengths similar - avoid O(n*m) waste)
            if (Math.abs(nq.length - nc.length) < Math.max(nq.length, nc.length) * 0.5) {
                const sim = calculateSimilarity(nq, nc);
                if (sim >= 0.55 && sim > bestScore) { bestScore = sim; bestMatch = candidate; continue; }
            }
            // 4. Token similarity
            const tokSim = tokenSimilarity(aq, ac);
            if (tokSim >= 0.6 && tokSim > bestScore) { bestScore = tokSim; bestMatch = candidate; }
        }
        return bestMatch;
    }

