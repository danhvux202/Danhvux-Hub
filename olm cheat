    function bypassTabDetection() {
        try {
            Object.defineProperty(document, 'hidden', { get: () => false, configurable: true });
            Object.defineProperty(document, 'visibilityState', { get: () => 'visible', configurable: true });
        } catch (e) { }

        const origAddEL = EventTarget.prototype.addEventListener;
        EventTarget.prototype.addEventListener = function (type, listener, options) {
            const blocked = ['visibilitychange', 'blur', 'focus', 'pause', 'resume', 'fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'msfullscreenchange', 'beforeunload'];
            if (blocked.includes(type)) return;
            return origAddEL.call(this, type, listener, options);
        };

        ['fullscreenElement', 'webkitFullscreenElement', 'mozFullScreenElement', 'msFullscreenElement'].forEach(prop => {
            try { Object.defineProperty(document, prop, { get: () => document.documentElement, configurable: true }); } catch (e) { }
        });

        ['copy', 'paste', 'cut', 'contextmenu', 'selectstart'].forEach(evt => {
            document.addEventListener(evt, (e) => e.stopImmediatePropagation(), true);
        });

        // Enable selection - run once + slow polling
        const enableSelection = () => {
            if (!document.body) return;
            document.body.style.userSelect = 'auto';
        };
        enableSelection();
        // Poll much slower (5s)
        setInterval(enableSelection, 5000);

        const origPrevent = Event.prototype.preventDefault;
        Event.prototype.preventDefault = function () {
            if (this.type === 'keydown') {
                const k = this.key, c = this.ctrlKey, s = this.shiftKey;
                if (k === 'F12' || (c && s && k === 'I') || (c && s && k === 'C') || (c && k === 'U')) return;
            }
            if (this.type === 'contextmenu') return;
            return origPrevent.call(this);
        };

        const blockedEndpoints = ['teacher-static', 'saveResult', 'teacher-log', 'newexam-log', 'course/teacher-static'];
        const origFetch = window.fetch;
        window.fetch = function (...args) {
            const url = String(args[0]);
            if (blockedEndpoints.some(e => url.includes(e))) return Promise.resolve(new Response('{"success":true}', { status: 200, headers: { 'Content-Type': 'application/json' } }));
            return origFetch.apply(this, args);
        };

        const origOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (m, url, ...rest) {
            if (blockedEndpoints.some(e => url.includes(e))) this._blocked = true;
            return origOpen.apply(this, [m, url, ...rest]);
        };
        const origSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.send = function (...args) { if (this._blocked) return; return origSend.apply(this, args); };

        // Cleanup warnings - run only when needed via MutationObserver (throttled)
        const cleanupWarnings = () => {
            const scoreEl = document.getElementById('tmp-score');
            if (scoreEl && scoreEl.textContent.includes('Dấu hiệu gian lận')) {
                scoreEl.textContent = '';
                scoreEl.classList.remove('text-danger', 'font-weight-bold');
            }
            document.querySelectorAll('.alert-danger, .alert-warning').forEach(el => {
                const t = el.textContent;
                if (t.includes('rời khỏi màn hình') || t.includes('toàn màn hình') || t.includes('gian lận') || (t.includes('Cảnh báo') && t.includes('thoát'))) el.remove();
            });
        };
        cleanupWarnings();
        // Throttled cleanup via slow interval
        setInterval(cleanupWarnings, 3000);

        window._dialogAlert = () => { };
        window._dialogConfirm = (t, m, cb) => { if (cb) cb(true); };

        const origSetItem = Storage.prototype.setItem;
        Storage.prototype.setItem = function (key, value) {
            if (key.startsWith('time_spent:') && localStorage.getItem('olm_time_frozen') === 'true') {
                const fv = localStorage.getItem('olm_frozen_time');
                if (fv) return origSetItem.call(this, key, fv);
                return;
            }
            return origSetItem.call(this, key, value);
        };
    }

    function stopAllTimers() {
        if (window.CATE_UI) {
            try {
                const timer = window.CATE_UI.getTimer();
                if (timer) {
                    timeFrozen = true;
                    frozenTimeSpent = timer.time_spent;
                    const data = window.CATE_UI.getData();
                    const lsKey = 'time_spent:' + data.id_page_user + '.' + data.id_category;
                    const fullKey = data.id_courseware ? lsKey + '.' + data.id_courseware : lsKey;
                    localStorage.setItem(fullKey, JSON.stringify(frozenTimeSpent));
                    localStorage.setItem('olm_time_frozen', 'true');
                    localStorage.setItem('olm_frozen_time', JSON.stringify(frozenTimeSpent));
                }
            } catch (e) { }
        }
        const timerEl = document.getElementById('timecount');
        if (timerEl) {
            frozenDisplayTime = timerEl.textContent;
            if (timerObserver) timerObserver.disconnect();
            timerObserver = new MutationObserver(() => {
                if (timeFrozen && timerEl.textContent !== frozenDisplayTime) timerEl.textContent = frozenDisplayTime;
            });
            timerObserver.observe(timerEl, { childList: true, characterData: true, subtree: true });
        }
    }

    function resumeAllTimers() {
        timeFrozen = false;
        frozenTimeSpent = null;
        frozenDisplayTime = null;
        try { localStorage.removeItem('olm_time_frozen'); localStorage.removeItem('olm_frozen_time'); } catch (e) { }
        if (timerObserver) { timerObserver.disconnect(); timerObserver = null; }
    }

