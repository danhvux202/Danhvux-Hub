    function setupDragAndResize() {
        const wrap = document.getElementById('olm-panel-wrap');
        const head = document.getElementById('olm-panel-head');
        const handle = wrap.querySelector('.olm-resize');
        let dragState = null;
        head.addEventListener('pointerdown', (e) => {
            if (e.button !== 0 && e.pointerType === 'mouse') return;
            if (e.target.closest('button')) return;
            const rect = wrap.getBoundingClientRect();
            wrap.style.right = 'auto';
            wrap.style.left = rect.left + 'px';
            wrap.style.top = rect.top + 'px';
            dragState = { sx: e.clientX, sy: e.clientY, ox: rect.left, oy: rect.top };
            window.addEventListener('pointermove', onMove);
            window.addEventListener('pointerup', onUp);
        });
        function onMove(e) {
            if (!dragState) return;
            e.preventDefault();
            const rect = wrap.getBoundingClientRect();
            const x = Math.max(6, Math.min(window.innerWidth - rect.width - 6, dragState.ox + e.clientX - dragState.sx));
            const y = Math.max(6, Math.min(window.innerHeight - rect.height - 6, dragState.oy + e.clientY - dragState.sy));
            wrap.style.left = x + 'px';
            wrap.style.top = y + 'px';
        }
        function onUp() { dragState = null; window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', onUp); }

        let rState = null;
        handle.addEventListener('pointerdown', (e) => {
            if (e.button !== 0 && e.pointerType === 'mouse') return;
            e.preventDefault(); e.stopPropagation();
            const rect = wrap.getBoundingClientRect();
            rState = { sx: e.clientX, sy: e.clientY, ow: rect.width, oh: rect.height, ol: rect.left };
            window.addEventListener('pointermove', onResize);
            window.addEventListener('pointerup', onResizeUp);
        });
        function onResize(e) {
            if (!rState) return;
            const dx = rState.sx - e.clientX;
            const dy = e.clientY - rState.sy;
            const w = Math.max(300, rState.ow + dx);
            const h = Math.max(200, rState.oh + dy);
            wrap.style.width = w + 'px';
            wrap.style.height = h + 'px';
            wrap.style.maxHeight = '90vh';
            wrap.style.left = (rState.ol - (w - rState.ow)) + 'px';
        }
        function onResizeUp() { rState = null; window.removeEventListener('pointermove', onResize); window.removeEventListener('pointerup', onResizeUp); }
    }

