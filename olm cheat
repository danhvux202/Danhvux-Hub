    function createScreenshotOverlay() {
        const overlay = document.createElement('div');
        overlay.id = 'olm-screenshot-overlay';
        overlay.style.cssText = `position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(3px); z-index: 9999998; cursor: crosshair;`;
        const hint = document.createElement('div');
        hint.style.cssText = `position: fixed; top: 60px; left: 50%; transform: translateX(-50%); background: rgba(28,28,30,0.95); backdrop-filter: blur(30px); color: #fff; padding: 10px 18px; border-radius: 12px; border: 0.5px solid rgba(255,255,255,0.12); font: 500 13px -apple-system; box-shadow: 0 10px 40px rgba(0,0,0,0.6);`;
        hint.textContent = 'Kéo chuột để chọn vùng chụp';
        overlay.appendChild(hint);
        document.body.appendChild(overlay);

        let startX, startY, box;
        function down(e) {
            if (e.target !== overlay) return;
            startX = e.clientX; startY = e.clientY;
            box = document.createElement('div');
            box.style.cssText = `position: fixed; border: 1.5px solid #0a84ff; background: rgba(10,132,255,0.15); box-shadow: 0 0 20px rgba(10,132,255,0.4); border-radius: 6px; z-index: 9999999; pointer-events: none;`;
            document.body.appendChild(box);
        }
        function move(e) {
            if (!box) return;
            box.style.left = Math.min(startX, e.clientX) + 'px';
            box.style.top = Math.min(startY, e.clientY) + 'px';
            box.style.width = Math.abs(e.clientX - startX) + 'px';
            box.style.height = Math.abs(e.clientY - startY) + 'px';
        }
        function up(e) {
            if (!box) return;
            const rect = box.getBoundingClientRect();
            if (rect.width > 50 && rect.height > 50) captureScreenArea(rect.left, rect.top, rect.width, rect.height);
            box.remove(); overlay.remove();
            document.removeEventListener('mousedown', down);
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
            document.removeEventListener('keydown', esc);
        }
        function esc(e) { if (e.key === 'Escape') { if (box) box.remove(); overlay.remove(); document.removeEventListener('mousedown', down); document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); document.removeEventListener('keydown', esc); } }
        document.addEventListener('mousedown', down);
        document.addEventListener('mousemove', move);
        document.addEventListener('mouseup', up);
        document.addEventListener('keydown', esc);
    }

    function loadHtml2Canvas() {
        return new Promise((resolve, reject) => {
            if (typeof html2canvas !== 'undefined') return resolve();
            const s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
            s.onload = resolve; s.onerror = () => reject(new Error('html2canvas load fail'));
            document.head.appendChild(s);
        });
    }

    async function captureScreenArea(left, top, width, height) {
        try {
            await loadHtml2Canvas();
            const panel = document.getElementById('olm-cheat-panel'), island = document.getElementById('olm-dynamic-island');
            if (panel) panel.style.display = 'none';
            if (island) island.style.display = 'none';
            await new Promise(r => setTimeout(r, 50));
            const canvas = await html2canvas(document.body, { x: left, y: top, width, height, useCORS: true, ignoreElements: (el) => el.id === 'olm-cheat-panel' || el.id === 'olm-screenshot-overlay' || el.id === 'olm-dynamic-island' });
            if (panel) panel.style.display = '';
            if (island) island.style.display = '';
            currentImageBase64 = canvas.toDataURL('image/png');
            await convertImageToTextAndAnswer();
        } catch (err) { log('Screenshot error: ' + err, '#ff453a'); }
    }

    async function convertImageToTextAndAnswer() {
        if (!currentImageBase64) return;
        if (!(islandMode === 'music' && Music.current)) {
            showDynamicIsland(); updateIslandLoading();
        }
        try {
            const res = await gmFetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${CONFIG.groqApiKey}` },
                body: JSON.stringify({
                    model: CONFIG.groqVisionModel,
                    messages: [{ role: 'user', content: [
                        { type: 'text', text: 'Extract ONLY the question text from this image. Ignore options (A,B,C,D), buttons, UI. Output just the question text.' },
                        { type: 'image_url', image_url: { url: currentImageBase64 } }
                    ] }],
                    max_tokens: 1500, temperature: 0.1
                })
            });
            if (!res.ok) throw new Error(`Vision API ${res.status}`);
            const data = await res.json();
            const extractedText = data.choices?.[0]?.message?.content?.trim();
            if (!extractedText) throw new Error('Không đọc được chữ');
            currentImageBase64 = null;

            const teacherAnswer = findAnswerByQuestionText(extractedText);
            if (teacherAnswer) {
                const ans = teacherAnswer.answerText || teacherAnswer.answerLetter;
                displayAIAnswer(ans, 99, 'DOC');
                if (teacherAnswer.answerLetter) highlightAnswer(teacherAnswer.answerLetter);
                if (!(islandMode === 'music' && Music.current)) updateIslandResult({ text: ans, source: 'DOC' });
                updateStats('docHits');
            } else {
                await askAIForAnswer(extractedText, !(islandMode === 'music' && Music.current));
            }
        } catch (e) {
            displayAIAnswer(e.message, null, 'ERR');
            if (!(islandMode === 'music' && Music.current)) updateIslandError(e.message);
        }
    }

