    // ============================================

    function init() {
        try { bypassTabDetection(); } catch (e) { console.error('bypass err:', e); }
        try { setupKeyboardShortcuts(); } catch (e) { console.error('kb err:', e); }

        // Wait for body
        const tryInitUI = () => {
            if (!document.body) { setTimeout(tryInitUI, 200); return; }
            try { createControlPanel(); } catch (e) { console.error('panel err:', e); }
            try { createDynamicIsland(); } catch (e) { console.error('island err:', e); }
            try { setupSelectionSearch(); } catch (e) { console.error('select err:', e); }
            try { startQuestionMonitoring(); } catch (e) { console.error('monitor err:', e); }
        };
        tryInitUI();

        try {
            if (localStorage.getItem('olm_time_frozen') === 'true') {
                const t = localStorage.getItem('olm_frozen_time');
                if (t) { timeFrozen = true; frozenTimeSpent = JSON.parse(t); CONFIG.isPaused = true; }
            }
        } catch (e) { }

        // Retry hijack
        if (!hijackEXAMUI()) {
            let n = 0;
            const p = setInterval(() => {
                if (hijackEXAMUI() || ++n > 50) clearInterval(p);
            }, 200);
        }
        if (!hijackCATEUI()) {
            let n = 0;
            const p = setInterval(() => {
                if (hijackCATEUI() || ++n > 50) clearInterval(p);
            }, 200);
        }

        // Delay doc download until DOM stable
        setTimeout(() => downloadAndParseTeacherDoc().catch(e => console.error('doc err:', e)), 1500);

        window.olmCheat = {
            select: selectAnswer, config: CONFIG, version: CONFIG.version,
            refreshTeacherDoc: downloadAndParseTeacherDoc, getTeacherDoc: () => teacherDocAnswers,
            search: (t) => searchSelectedText(t),
            export: exportAnswers, stats: () => stats,
            clearCache: () => { answerCache = {}; GM_setValue('answerCache', {}); },
            palette: openCommandPalette,
            setApiKey: (k) => { CONFIG.groqApiKey = k; GM_setValue('groqApiKey', k); },
            music: { play: playMusicURL, stop: stopMusic, toggle: toggleMusicPlayPause, state: () => Music }
        };

        console.log('%c[OLM CHEAT V6.2] Loaded.', 'color: #0a84ff; font-size: 14px; font-weight: 600;');
    }

    // Wait for load
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else setTimeout(init, 100);

})();
