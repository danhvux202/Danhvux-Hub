    async function downloadAndParseTeacherDoc() {
        const isExamPage = window.location.pathname.match(/\/chu-de\//);
        if (!isExamPage) { teacherDocAnswers = []; populateQAList(); return; }
        if (isDownloadingDoc || teacherDocAnswers !== null) return;
        isDownloadingDoc = true;
        try {
            await loadJSZip();
            const pathMatch = window.location.pathname.match(/(\d+)$/);
            if (!pathMatch) { teacherDocAnswers = []; return; }
            const id_cate = pathMatch[0];
            const apiUrl = `https://olm.vn/download-word-for-user?id_cate=${id_cate}&showAns=1&questionNotApproved=0`;
            const response = await fetch(apiUrl);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            if (!data || !data.file) throw new Error('No file URL');
            const fileResponse = await fetch(data.file);
            if (!fileResponse.ok) throw new Error(`Failed: ${fileResponse.status}`);
            const arrayBuffer = await fileResponse.arrayBuffer();
            const zip = await JSZip.loadAsync(arrayBuffer);
            const documentXml = await zip.file('word/document.xml').async('string');
            teacherDocAnswers = parseDocxXML(documentXml);
            populateQAList();
        } catch (error) {
            console.error('[OLM] Doc error:', error);
            teacherDocAnswers = [];
        } finally { isDownloadingDoc = false; }
    }

    function parseDocxXML(xmlContent) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlContent, 'text/xml');
        const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
        const V = 'urn:schemas-microsoft-com:vml';
        const RN = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';

        const allRuns = xmlDoc.getElementsByTagNameNS(W, 'r');
        const textChunks = [];
        let position = 0;
        for (let i = 0; i < allRuns.length; i++) {
            const run = allRuns[i];
            let isUnderlined = false;
            const rPr = run.getElementsByTagNameNS(W, 'rPr')[0];
            if (rPr && rPr.getElementsByTagNameNS(W, 'u').length > 0) isUnderlined = true;
            for (const child of run.childNodes) {
                const name = child.nodeName;
                if (name === 'w:t') { textChunks.push({ text: child.textContent, isUnderlined, start: position }); position += child.textContent.length; }
                else if (name === 'w:object') {
                    const imgDatas = child.getElementsByTagNameNS(V, 'imagedata');
                    if (imgDatas.length > 0) {
                        const rId = imgDatas[0].getAttributeNS(RN, 'id') || imgDatas[0].getAttribute('r:id') || '';
                        if (rId) { const token = `[IMG:${rId}]`; textChunks.push({ text: token, isUnderlined, start: position }); position += token.length; }
                    }
                }
            }
        }
        const fullText = textChunks.map(c => c.text).join('');
        const questionRegex = /(Question\s+\d+\.|Câu\s+\d+\.)/gi;
        const questionMarkers = [];
        let match;
        while ((match = questionRegex.exec(fullText)) !== null) questionMarkers.push({ marker: match[0], index: match.index });

        const qaPairs = [];
        for (let qIdx = 0; qIdx < questionMarkers.length; qIdx++) {
            const startIdx = questionMarkers[qIdx].index + questionMarkers[qIdx].marker.length;
            const endIdx = qIdx + 1 < questionMarkers.length ? questionMarkers[qIdx + 1].index : fullText.length;
            const block = fullText.substring(startIdx, endIdx).trim();
            let answerLetter = null;
            for (const chunk of textChunks) {
                if (chunk.start >= startIdx && chunk.start < endIdx && chunk.isUnderlined) {
                    const letterMatch = chunk.text.trim().match(/^([A-D])\.?\s*$/);
                    if (letterMatch) { answerLetter = letterMatch[1]; break; }
                }
            }
            const textAnswerMatch = block.match(/^(.+?)\s*\[([^\]]+)\]\s*$/s);
            if (textAnswerMatch) { qaPairs.push({ question: textAnswerMatch[1].replace(/\s+/g, ' ').trim(), answerLetter: null, answerText: textAnswerMatch[2].trim(), isTextAnswer: true }); continue; }
            const isTrueFalse = /[a-d]\).*?\(\s*[TF]\s*\)/i.test(block);
            if (isTrueFalse) {
                const mainQuestionMatch = block.match(/^(.+?)(?=\s*a\))/s);
                const mainQuestion = mainQuestionMatch ? mainQuestionMatch[1].replace(/\s+/g, ' ').trim() : '';
                const subQuestions = [];
                const subMatches = block.matchAll(/([a-d])\)\s*(.+?)\s*\(\s*([TF])\s*\)/gi);
                for (const m of subMatches) subQuestions.push({ letter: m[1].toLowerCase(), questionText: m[2].trim(), answer: m[3].toUpperCase() === 'T' ? 'Đ' : 'S' });
                if (subQuestions.length > 0) qaPairs.push({ question: mainQuestion, answerLetter: null, answerText: subQuestions.map(sq => `${sq.letter}) ${sq.answer}`).join('\n'), isTrueFalse: true, subQuestions });
                continue;
            }
            if (!answerLetter) continue;
            let questionText = '';
            const firstOptionMatch = block.match(/(?:^|\n)\s*A\.\s/);
            if (firstOptionMatch) questionText = block.substring(0, firstOptionMatch.index).replace(/\s+/g, ' ').trim();
            else { const qm = block.match(/^(.+?)(?=\s*A\.|$)/s); questionText = qm ? qm[1].replace(/\s+/g, ' ').trim() : block.substring(0, 100); }
            const options = {};
            const optionRegex = /([A-D])\.\s*(.+?)(?=[A-D]\.|$)/gs;
            let optMatch;
            while ((optMatch = optionRegex.exec(block)) !== null) {
                const letter = optMatch[1];
                let text = optMatch[2].trim().replace(/\.\s*$/, '').replace(/\s+[A-D]\.?\s*$/, '').trim();
                if (text && text.length > 1) options[letter] = text;
            }
            qaPairs.push({ question: questionText, answerLetter, answerText: options[answerLetter] || answerLetter, allOptions: options, isTrueFalse: false, isTextAnswer: false });
        }
        return qaPairs;
    }

    function findAnswerByQuestionText(questionText) {
        if (!teacherDocAnswers || teacherDocAnswers.length === 0) return null;
        return findBestMatch(questionText, teacherDocAnswers);
    }

    // ============================================
    // CACHE + STATS (debounced write)
    // ============================================

    function getCacheKey(q) { return 'q_' + hashString(normalizeVietnamese(q).substring(0, 100)); }
    function getCachedAnswer(q) { return answerCache[getCacheKey(q)] || null; }

    function scheduleCacheWrite() {
        cacheDirty = true;
        if (cacheWriteTimer) return;
        cacheWriteTimer = setTimeout(() => {
            if (cacheDirty) {
                // Trim if too large
                const keys = Object.keys(answerCache);
                if (keys.length > 500) {
                    keys.sort((a, b) => answerCache[a].time - answerCache[b].time);
                    for (let i = 0; i < 100; i++) delete answerCache[keys[i]];
                }
                GM_setValue('answerCache', answerCache);
                cacheDirty = false;
            }
            cacheWriteTimer = null;
        }, CONFIG.cacheWriteDebounceMs);
    }

    function setCachedAnswer(q, answer, source) {
        answerCache[getCacheKey(q)] = { answer, source, time: Date.now() };
        scheduleCacheWrite();
    }

    function updateStats(field) { stats[field] = (stats[field] || 0) + 1; GM_setValue('stats', stats); }

    // ============================================
    // DISPLAY
    // ============================================

    function displayAIAnswer(answer, confidence, source) {
        const box = document.getElementById('olm-ai-answer');
        if (!box) return;
        let displayText = String(answer || '');
        if (/^[A-D]$/i.test(displayText.trim()) && currentQuestionData && currentQuestionData.answers) {
            const idx = displayText.trim().toUpperCase().charCodeAt(0) - 65;
            if (currentQuestionData.answers[idx]) displayText = currentQuestionData.answers[idx];
        }
        const sourceLabel = source === 'DOC' ? 'DOC' : source === 'CACHE' ? 'CACHE' : source === 'ERR' ? 'LỖI' : 'AI';
        const color = source === 'DOC' ? '#30d158' : source === 'ERR' ? '#ff453a' : '#0a84ff';
        const bg = source === 'DOC' ? 'rgba(48,209,88,0.18)' : source === 'ERR' ? 'rgba(255,69,58,0.18)' : 'rgba(10,132,255,0.18)';
        box.innerHTML = `<div style="display:flex;align-items:flex-start;gap:10px;">
            <span style="font-size:10px;font-weight:700;letter-spacing:0.5px;padding:2px 7px;border-radius:5px;background:${bg};color:${color};flex-shrink:0;margin-top:2px;">${sourceLabel}</span>
            <span style="flex:1;color:rgba(255,255,255,0.92);font-size:13.5px;line-height:1.5;word-break:break-word;">${displayText}</span>
        </div>`;
        isAIThinking = false;
    }

    function highlightAnswer(letter) {
        const answerElements = getAnswerElements();
        const index = letter.toUpperCase().charCodeAt(0) - 65;
        if (!answerElements[index]) return;
        answerElements.forEach(el => { el.style.background = ''; el.style.border = ''; el.style.boxShadow = ''; el.style.transform = ''; });
        const target = answerElements[index];
        target.style.background = 'rgba(10, 132, 255, 0.15)';
        target.style.border = '2px solid #0a84ff';
        target.style.borderRadius = '10px';
        target.style.transition = 'all 0.35s cubic-bezier(0.34, 1.3, 0.64, 1)';
        target.style.boxShadow = '0 0 0 4px rgba(10, 132, 255, 0.12)';
        target.style.transform = 'scale(1.02)';
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => { target.style.transform = ''; }, 500);
    }

    function selectAnswer(letter) {
        const answerElements = getAnswerElements();
        const index = letter.toUpperCase().charCodeAt(0) - 65;
        if (!answerElements[index]) return;
        const el = answerElements[index];
        const input = el.querySelector('input') || (el.previousElementSibling && el.previousElementSibling.tagName === 'INPUT' ? el.previousElementSibling : document.querySelector('input[id="' + el.getAttribute('for') + '"]'));
        if (input) { input.click(); input.checked = true; input.dispatchEvent(new Event('change', { bubbles: true })); }
        el.click();
        Sound.click();
        updateStats('answered');
    }

    // ============================================
    // AI
    // ============================================

    async function askAIForAnswer(customQuestion, useIsland) {
        if (isAIThinking) return;
        const questionText = customQuestion || (currentQuestionData && currentQuestionData.question);
        const answerTexts = customQuestion ? [] : ((currentQuestionData && currentQuestionData.answers) || []);
        if (!questionText) return;

        const cached = getCachedAnswer(questionText);
        if (cached) {
            displayAIAnswer(cached.answer, 95, 'CACHE');
            updateStats('cacheHits');
            if (cached.answer.match(/^[A-D]/)) highlightAnswer(cached.answer[0]);
            if (useIsland) updateIslandResult({ text: cached.answer, source: 'CACHE' });
            return;
        }

        isAIThinking = true;
        const aiBox = document.getElementById('olm-ai-answer');
        if (aiBox) aiBox.innerHTML = `<div style="color:rgba(255,255,255,0.4);font-size:12.5px;">Đang hỏi AI...</div>`;
        if (useIsland) updateIslandLoading();

        try {
            let prompt = answerTexts.length > 0
                ? `You are taking a Vietnamese quiz. Answer ONLY with the letter (A, B, C, or D). No explanations.\n\nQuestion: ${questionText}\n\nOptions:\n${answerTexts.map((a, i) => `${String.fromCharCode(65 + i)}. ${a}`).join('\n')}\n\nAnswer (letter only):`
                : `Answer this Vietnamese question. Give ONLY a concise answer, no explanations:\n\n${questionText}`;
            if (CONFIG.knowledge) prompt = `KNOWLEDGE BASE:\n${CONFIG.knowledge}\n\n${prompt}`;

            const response = await gmFetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${CONFIG.groqApiKey}` },
                body: JSON.stringify({
                    model: CONFIG.groqTextModel,
                    messages: [{ role: 'system', content: 'You are a helpful quiz assistant. Answer concisely.' }, { role: 'user', content: prompt }],
                    max_tokens: 200, temperature: 0.3
                })
            });

            if (!response.ok) {
                const t = await response.text();
                if (response.status === 429 || t.includes('rate_limit')) throw new Error('Rate limit - lấy key free tại console.groq.com');
                throw new Error(`API ${response.status}`);
            }

            const data = await response.json();
            const answer = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content && data.choices[0].message.content.trim();
            if (!answer) throw new Error('Không có đáp án');

            const letterMatch = answer.match(/^([A-D])/i);
            if (letterMatch) {
                const letter = letterMatch[1].toUpperCase();
                const idx = letter.charCodeAt(0) - 65;
                const fullAns = answerTexts[idx] || letter;
                displayAIAnswer(fullAns, 85, 'AI');
                highlightAnswer(letter);
                setCachedAnswer(questionText, fullAns, 'AI');
                updateStats('aiHits');
                Sound.success();
                if (useIsland) updateIslandResult({ text: fullAns, source: 'AI' });
                if (CONFIG.autoAnswer) setTimeout(() => selectAnswer(letter), 300);
            } else {
                displayAIAnswer(answer, null, 'AI');
                setCachedAnswer(questionText, answer, 'AI');
                updateStats('aiHits');
                Sound.success();
                if (useIsland) updateIslandResult({ text: answer, source: 'AI' });
            }
        } catch (error) {
            displayAIAnswer(error.message, null, 'ERR');
            Sound.error();
            if (useIsland) updateIslandError(error.message);
        } finally { isAIThinking = false; }
    }

    // ============================================
    // QUESTION CHANGE (optimized)
    // ============================================

    function detectQuestionChange() {
        // Skip if music expanded to avoid island mode conflict
        const questionText = getQuestionText();
        if (!questionText) return false;
        const answerTexts = getAnswerTexts();

        // Quick string-equality check before hashing
        if (questionText === lastQuestionText && answerTexts.join('|') === lastAnswerTexts.join('|')) return false;
        lastQuestionText = questionText;
        lastAnswerTexts = answerTexts;

        const currentHash = hashString(questionText + answerTexts.join(''));
        if (currentHash === lastQuestionHash) return false;
        lastQuestionHash = currentHash;

        currentQuestionData = { question: questionText, answers: answerTexts };
        updateStats('total');

        const teacherAnswer = findAnswerByQuestionText(questionText);
        if (teacherAnswer) {
            const ans = teacherAnswer.answerText || teacherAnswer.answerLetter;
            displayAIAnswer(ans, 99, 'DOC');
            if (teacherAnswer.answerLetter) highlightAnswer(teacherAnswer.answerLetter);
            setCachedAnswer(questionText, ans, 'DOC');
            updateStats('docHits');
            Sound.success();
            if (CONFIG.autoAnswer && teacherAnswer.answerLetter) setTimeout(() => selectAnswer(teacherAnswer.answerLetter), 300);
        } else {
            setTimeout(() => askAIForAnswer(), 500);
        }
        return true;
    }

    function scheduleDetect() {
        if (detectScheduled) return;
        const now = Date.now();
        const elapsed = now - lastDetectAt;
        const delay = Math.max(50, CONFIG.detectIntervalMs - elapsed);
        detectScheduled = true;
        setTimeout(() => {
            detectScheduled = false;
            lastDetectAt = Date.now();
            try { detectQuestionChange(); } catch (e) { log('detect err: ' + e.message, '#ff453a'); }
        }, delay);
    }

    function startQuestionMonitoring() {
        // Interval fallback (slower)
        setInterval(() => { scheduleDetect(); }, CONFIG.detectIntervalMs);

        // MutationObserver only on main question container, without characterData
        const target = document.querySelector('#main-content, .container, .card, main') || document.body;
        const observer = new MutationObserver(() => { scheduleDetect(); });
        observer.observe(target, { childList: true, subtree: true });
    }

