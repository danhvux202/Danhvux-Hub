local function mkToggle(parent, title, desc, default, callback)
    local row = mkItem(parent, title, desc)
    local onVal = default or false
    local track = New("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = onVal and C.ACCENT or C.ITEM2,
        BorderSizePixel = 0,
        Parent = row,
    }, { mkCorner(10) })
    local knob = New("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = onVal and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3),
        BackgroundColor3 = C.WHITE,
        BorderSizePixel = 0,
        Parent = track,
    }, { mkCorner(7) })
    local btn = New("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = row })
    btn.MouseButton1Click:Connect(function()
        onVal = not onVal
        TweenService:Create(track, TweenInfo.new(0.15), { BackgroundColor3 = onVal and C.ACCENT or C.ITEM2 }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), { Position = onVal and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3) }):Play()
        if callback then callback(onVal) end
    end)
    if callback and default then callback(default) end
    return row
end

