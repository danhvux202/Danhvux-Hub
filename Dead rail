local function farmBonds()
    local player = Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid")
    running = true
    notify("Bond Farm", "Bắt đầu farm!")

    while running do
        TPTo(char, maximGunTP)
        task.wait(0.5)
        local seat = getMaximGunSeat()
        if seat then
            seat.Disabled = false
            sitAndJumpOutSeat(char, seat)
            break
        end
        task.wait(1)
    end

    for i, pos in ipairs(bondPositions) do
        if not running then break end
        TPTo(char, pos)
        task.wait(waitTime)
        if i == 2 then enableFly() end
        while running do
            local items = Workspace:FindFirstChild("RuntimeItems")
            local allGone = true
            for _, bond in ipairs(items and items:GetChildren() or {}) do
                if bond:IsA("Model") and (bond.Name == "Bond" or bond.Name == "Bonds") and bond.PrimaryPart and bond.Parent ~= nil then
                    local dist = (bond.PrimaryPart.Position - hrp.Position).Magnitude
                    if dist < 15 then
                        if bondRemote then
                            pcall(function() bondRemote:FireServer(bond) end)
                        end
                        allGone = false
                    elseif dist >= 15 then
                        TPTo(char, Vector3.new(bond.PrimaryPart.Position.X, bond.PrimaryPart.Position.Y - 5, bond.PrimaryPart.Position.Z))
                        task.wait(collectWaitTime)
                        allGone = false
                        break
                    end
                end
            end
            if allGone then break end
            task.wait(collectWaitTime)
        end
    end

    disableFly()
    running = false
    notify("Bond Farm", "Farm kết thúc!")
end

