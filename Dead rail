        local fps = math.floor(frameCount / dt)
        frameCount = 0
        lastFT = now
        fpsLbl.Text = "FPS: " .. fps
        fpsLbl.TextColor3 = fps >= 55 and C.GREEN or (fps >= 30 and C.ACCENT or C.RED)
    end
end)

