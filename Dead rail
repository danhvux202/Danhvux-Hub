local function mkTab(label, order)
    local btn = New("TextButton", {
        Name = label,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.SIDEBAR,
        BorderSizePixel = 0,
        Text = "",
        LayoutOrder = order,
        Parent = SidebarScroll,
    })
    local line = New("Frame", {
        Size = UDim2.new(0, 2, 0, 20),
        Position = UDim2.fromOffset(0, 8),
        BackgroundColor3 = C.ACCENT,
        Visible = false,
        BorderSizePixel = 0,
        Parent = btn,
    }, { mkCorner(1) })
    New("TextLabel", {
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 12.5,
        TextColor3 = C.TEXT2,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 1, 0),
        Position = UDim2.fromOffset(18, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })
    local pane = New("ScrollingFrame", {
        Name = label .. "Pane",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.BORDER,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = ContentArea,
    })
    mkPadding(14, 14, 16, 16).Parent = pane
    mkListLayout(Enum.FillDirection.Vertical, 0).Parent = pane
    tabButtons[label] = { btn = btn, line = line, pane = pane }
    btn.MouseButton1Click:Connect(function()
        if activeTab == label then return end
        for _, v in pairs(tabButtons) do
            v.pane.Visible = false
            v.line.Visible = false
            local tl = v.btn:FindFirstChildWhichIsA("TextLabel")
            if tl then tl.TextColor3 = C.TEXT2 end
            v.btn.BackgroundColor3 = C.SIDEBAR
        end
        pane.Visible = true
        line.Visible = true
        local tl = btn:FindFirstChildWhichIsA("TextLabel")
        if tl then tl.TextColor3 = C.ACCENT end
        btn.BackgroundColor3 = C.ACCENT_BG
        activeTab = label
        pane.CanvasPosition = Vector2.new(0, 0)
    end)
    return pane
end

