                    if runtimeEntities then
                        for _, obj in ipairs(runtimeEntities:GetChildren()) do
                            if obj:IsA("Model") and obj.Name == horseModelNames[horseKey] then
                                entity = obj
                                break
                            end
                        end
                    end
