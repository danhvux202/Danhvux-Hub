local function mkSlider(parent, title, min, max, default, callback)
    local frame = New("Frame", {
        BackgroundColor3 = C.ITEM,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 56),
        Parent = parent
    }, { mkCorner(6), New("UIStroke", { Color = C.BORDER, Thickness = 0.5 }) })
    mkPadding(8, 10, 12, 12).Parent = frame
    local topRow = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        BorderSizePixel = 0,
        Parent = frame
    })
    New("TextLabel", {
        Text = title,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextColor3 = C.TEXT1,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -50, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topRow
    })
    local valLbl = New("TextLabel", {
        Text = tostring(default),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.ACCENT,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 44, 1, 0),
        Position = UDim2.new(1, -44, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = topRow
    })
    local pct = math.clamp((default - min) / (max - min), 0, 1)
    local trackBg = New("Frame", {
        BackgroundColor3 = C.BORDER,
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 1, -8),
        BorderSizePixel = 0,
        Parent = frame
    }, { mkCorner(2) })
    local fill = New("Frame", {
        BackgroundColor3 = C.ACCENT,
        Size = UDim2.new(pct, 0, 1, 0),
        BorderSizePixel = 0,
        Parent = trackBg
    }, { mkCorner(2) })
    local thumb = New("Frame", {
        BackgroundColor3 = C.WHITE,
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(pct, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = trackBg
    }, { mkCorner(7) })
    local dragging = false
    local function upd(x)
        local ap = trackBg.AbsolutePosition.X
        local as = trackBg.AbsoluteSize.X
        if as < 1 then return end
        local rel = math.clamp((x - ap) / as, 0, 1)
        local val = math.floor(min + rel * (max - min))
        fill.Size = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(val)
        if callback then callback(val) end
    end
    local sb = New("TextButton", {
        Size = UDim2.new(1, 10, 0, 20),
        Position = UDim2.new(0, -5, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 3,
        Parent = trackBg
    })
    sb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            upd(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    mkSpacer(parent, 4)
    if callback then callback(default) end
    return frame
end

local function mkDropdown(parent, title, options, default, callback)
    local frame = New("Frame", {
        BackgroundColor3 = C.ITEM,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = false,
        Parent = parent
    }, { mkCorner(6), New("UIStroke", { Color = C.BORDER, Thickness = 0.5 }) })
    mkPadding(10, 10, 12, 12).Parent = frame
    local hdr = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        BorderSizePixel = 0,
        Parent = frame
    })
    New("TextLabel", {
        Text = title,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12.5,
        TextColor3 = C.TEXT1,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = hdr
    })
    local curVal = default or options[1]
    local selLbl = New("TextLabel", {
        Text = curVal,
        Font = Enum.Font.Gotham,
        TextSize = 11.5,
        TextColor3 = C.TEXT2,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -22, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = hdr
    })
    local arrow = New("TextLabel", {
        Text = "v",
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = C.TEXT3,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -16, 0, 1),
        Parent = hdr
    })
    local open = false
    local listFrame = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(28, 28, 28),
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 50,
        Parent = ScreenGui
    }, { mkCorner(6), New("UIStroke", { Color = C.BORDER, Thickness = 0.5 }), mkListLayout(Enum.FillDirection.Vertical, 0), mkPadding(4, 4, 0, 0) })
    local function populate()
        for _, c in pairs(listFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, opt in ipairs(options) do
            local ob = New("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 28),
                Text = "",
                BorderSizePixel = 0,
                ZIndex = 51,
                Parent = listFrame
            })
            New("TextLabel", {
                Text = opt,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextColor3 = opt == curVal and C.ACCENT or C.TEXT2,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.fromOffset(10, 0),
                ZIndex = 51,
                Parent = ob
            })
            ob.MouseEnter:Connect(function()
                ob.BackgroundTransparency = 0
                ob.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            end)
            ob.MouseLeave:Connect(function()
                ob.BackgroundTransparency = 1
            end)
            ob.MouseButton1Click:Connect(function()
                curVal = opt
                selLbl.Text = opt
                for _, c in pairs(listFrame:GetChildren()) do
                    if c:IsA("TextButton") then
                        local tl = c:FindFirstChildWhichIsA("TextLabel")
                        if tl then tl.TextColor3 = tl.Text == opt and C.ACCENT or C.TEXT2 end
                    end
                end
                open = false
                listFrame.Visible = false
                arrow.Text = "v"
                if callback then callback(opt) end
            end)
        end
    end
    populate()
    local hb = New("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = hdr })
    hb.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local ap = hdr.AbsolutePosition
            local as = hdr.AbsoluteSize
            listFrame.Position = UDim2.fromOffset(ap.X, ap.Y + as.Y + 4)
            listFrame.Size = UDim2.new(0, as.X, 0, 0)
        end
        listFrame.Visible = open
        arrow.Text = open and "^" or "v"
    end)
    mkSpacer(parent, 4)
    if callback then callback(curVal) end
    return frame, function(newOpts, newDefault)
        options = newOpts
        curVal = newDefault or newOpts[1]
        selLbl.Text = curVal
        populate()
        if callback then callback(curVal) end
    end
end

