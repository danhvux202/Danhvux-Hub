            task.wait(0.3)
            for _ = 1, math.floor((horseKey == "Unicorn" and 0.5 or 2) / scanInterval) do
                local entity
                if horseKey == "Unicorn" then
                    entity = Workspace:FindFirstChild("Model_Unicorn") or
                             (Workspace.Baseplates and Workspace.Baseplates.Baseplate and Workspace.Baseplates.Baseplate.CenterBaseplate and Workspace.Baseplates.Baseplate.CenterBaseplate.Animals and Workspace.Baseplates.Baseplate.CenterBaseplate.Animals.Model_Unicorn) or
