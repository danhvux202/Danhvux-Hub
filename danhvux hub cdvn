local function GetVehicleFromDescendant(Descendant)
    return Descendant:FindFirstAncestor(LocalPlayer.Name .. "\'s Car") or
           (Descendant:FindFirstAncestor("Body") and Descendant:FindFirstAncestor("Body").Parent) or
           (Descendant:FindFirstAncestor("Misc") and Descendant:FindFirstAncestor("Misc").Parent) or
           Descendant:FindFirstAncestorWhichIsA("Model")
end

task.spawn(function()
    while task.wait() do
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                if hum and root then
                    hum.WalkSpeed = 16 
                    if WalkSpeedValue > 0 and hum.MoveDirection.Magnitude > 0 then
                        root.CFrame = root.CFrame + (hum.MoveDirection * (WalkSpeedValue / 10))
                    end
                    hum.JumpPower = JumpPowerValue
                    hum.UseJumpPower = true 
                end
            end
        end)
    end
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        local Character = LocalPlayer.Character
        if Character then
            local Humanoid = Character:FindFirstChildWhichIsA("Humanoid")
            if Humanoid and Humanoid.SeatPart and Humanoid.SeatPart:IsA("VehicleSeat") then
                local SeatPart = Humanoid.SeatPart
                local Vehicle = GetVehicleFromDescendant(SeatPart)
                if not Vehicle then return end
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    SeatPart.AssemblyLinearVelocity = SeatPart.AssemblyLinearVelocity * Vector3.new(1 + accelMult, 1, 1 + accelMult)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    SeatPart.AssemblyLinearVelocity = SeatPart.AssemblyLinearVelocity * Vector3.new(1 - brakeMult, 1, 1 - brakeMult)
                end
                
                if antiFlipEnabled then
                    local PrimaryPart = Vehicle.PrimaryPart or SeatPart
                    if PrimaryPart then
                        local cf = PrimaryPart.CFrame
                        if cf.UpVector.Y < 0.7 or math.abs(cf.RightVector.Y) > 0.7 then
                            local camera = workspace.CurrentCamera
                            local lookDir = camera.CFrame.LookVector
                            PrimaryPart.CFrame = CFrame.lookAt(cf.Position, cf.Position + Vector3.new(lookDir.X, 0, lookDir.Z))
                            SeatPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                end
            end
        end
    end)
end)

