-- ================= HÀM HỖ TRỢ =================
local function safeTeleport(cf)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = cf
    end
end

local function pressKey(key)
    Vim:SendKeyEvent(true, key, false, game)
    task.wait(0.05)
    Vim:SendKeyEvent(false, key, false, game)
    task.wait(0.05)
end

local function releaseF()
    if isHoldingF then
        Vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        isHoldingF = false
    end
end

local function holdF()
    if not isHoldingF then
        Vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        isHoldingF = true
    end
end

local function findCash()
    local nilCash = getNil("Cash", "MeshPart")
    if nilCash then return nilCash end
    local cashFolder = workspace:FindFirstChild("CityNPCs") and workspace.CityNPCs:FindFirstChild("Drop") and workspace.CityNPCs.Drop:FindFirstChild("Cash")
    local money = cashFolder and cashFolder:FindFirstChildOfClass("BasePart")
    if money then return money end
    return nil
end

local function equipPhongLon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    if char:FindFirstChild("PhongLon") then return end
    
    releaseF() 
    local toolInBackpack = player.Backpack:FindFirstChild("PhongLon")
    if toolInBackpack then
        char.Humanoid:EquipTool(toolInBackpack)
    else
        Vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        task.wait(0.1)
        pressKey(Enum.KeyCode.Backquote)
        pressKey(Enum.KeyCode.BackSlash)
        pressKey(Enum.KeyCode.Down)
        pressKey(Enum.KeyCode.Right)
        pressKey(Enum.KeyCode.Up)
        pressKey(Enum.KeyCode.Up)
        pressKey(Enum.KeyCode.Left)
        pressKey(Enum.KeyCode.Down)
        pressKey(Enum.KeyCode.Return)
        task.wait(0.2)
        pressKey(Enum.KeyCode.BackSlash)
        pressKey(Enum.KeyCode.Down)
        pressKey(Enum.KeyCode.Right)
        pressKey(Enum.KeyCode.Up)
        pressKey(Enum.KeyCode.Up)
        pressKey(Enum.KeyCode.Up)
        pressKey(Enum.KeyCode.Return)
        task.wait(0.3)
    end
end

-- ================= ESP LOGIC (DRAWING API) =================
local function createDrawing(class, properties)
    local d = Drawing.new(class)
    for i, v in pairs(properties) do d[i] = v end
    return d
end

local function ApplyESP(Player)
    local Box = createDrawing("Square", { Thickness = 1, Filled = false, Color = Color3.new(1, 1, 1), Visible = false })
    local HealthBar = createDrawing("Square", { Thickness = 1, Filled = true, Color = Color3.new(0, 1, 0), Visible = false })
    local Tracer = createDrawing("Line", { Thickness = 1, Color = Color3.new(1, 1, 1), Visible = false })
    local DistanceText = createDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.new(1, 1, 1), Visible = false })

    local function Update()
        local connection
        connection = RunService.RenderStepped:Connect(function()
            if ESP_Enabled and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character:FindFirstChild("Humanoid") and Player ~= LocalPlayer then
                local RootPart = Player.Character.HumanoidRootPart
                local Humanoid = Player.Character.Humanoid
                local Pos, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)

                if OnScreen then
                    local Size = (Camera:WorldToViewportPoint(RootPart.Position - Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(RootPart.Position + Vector3.new(0, 2.6, 0)).Y)
                    local BoxSize = Vector2.new(Size / 1.5, Size)
                    local BoxPos = Vector2.new(Pos.X - BoxSize.X / 2, Pos.Y - BoxSize.Y / 2)

                    -- Box ESP
                    Box.Visible = ESP_Box
                    Box.Size = BoxSize
                    Box.Position = BoxPos

                    -- Health Bar
                    HealthBar.Visible = ESP_Health
                    HealthBar.Size = Vector2.new(2, BoxSize.Y * (Humanoid.Health / Humanoid.MaxHealth))
                    HealthBar.Position = Vector2.new(BoxPos.X - 5, BoxPos.Y + (BoxSize.Y - HealthBar.Size.Y))
                    HealthBar.Color = Color3.fromHSV(Humanoid.Health / Humanoid.MaxHealth * 0.3, 1, 1)

                    -- Distance
                    if ESP_Distance then
                        local dist = math.floor((RootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                        DistanceText.Visible = true
                        DistanceText.Text = "[" .. dist .. "m]"
                        DistanceText.Position = Vector2.new(BoxPos.X + BoxSize.X / 2, BoxPos.Y + BoxSize.Y + 2)
                    else
                        DistanceText.Visible = false
                    end

                    -- Tracers
                    if ESP_Tracer then
                        Tracer.Visible = true
                        Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        Tracer.To = Vector2.new(Pos.X, Pos.Y + (BoxSize.Y / 2))
                    else
                        Tracer.Visible = false
                    end
                else
                    Box.Visible = false
                    HealthBar.Visible = false
                    Tracer.Visible = false
                    DistanceText.Visible = false
                end
            else
                Box.Visible = false
                HealthBar.Visible = false
                Tracer.Visible = false
                DistanceText.Visible = false
                if not Player.Parent then connection:Disconnect() end
            end
        end)
    end
    coroutine.wrap(Update)()
end

